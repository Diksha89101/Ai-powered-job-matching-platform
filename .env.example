# Required
MONGO_URI=mongodb://localhost:27017/jobplatform
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FLASK_ENV=development

# Access tokens are short-lived; refresh credentials are HttpOnly cookies.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# memory:// is for local single-process development; configure shared storage
# (for example Redis) when running multiple application workers.
RATELIMIT_STORAGE_URI=memory://

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your16charapppass
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com

# Local development only: show a reset link when SMTP is unavailable.
# Never enable this in production.
ALLOW_DEV_RESET_LINK=False

# CSP remains report-only until inline scripts/styles are migrated.
CSP_REPORT_ONLY=True
# HSTS defaults to enabled in production. Ensure TLS is terminated correctly.

# Hybrid recommendation weights (normalized automatically)
HYBRID_SEMANTIC_WEIGHT=0.45
HYBRID_SKILLS_WEIGHT=0.40
HYBRID_TITLE_WEIGHT=0.10
HYBRID_EXPERIENCE_WEIGHT=0.05
